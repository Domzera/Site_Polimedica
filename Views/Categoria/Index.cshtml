@model IEnumerable<Categoria>

<head>
    <style>
        .text-decora {
            background-color: transparent;
            border: none;
            text-decoration: none;
        }
    </style>
</head>

<main>
    <sectin>
        <section class="py-2 text-center container">
            <div class="row py-lg-5">
                <div class="col-lg-6 col-md-8 mx-auto">
                    <h1 class="fw-light">Categorias</h1>
                    <p class="lead text-muted">Aqui você encontra o que procura!.</p>

                </div>
            </div>
        </section>
    </sectin>
    <section>
        <div class="album py-2 bg-light">
            <div class="container">
                <!-- Aqui eu arrumo quantidade de itens por linha-->
                <div class="row row-cols-4 row-cols-sm-4 row-cols-md-4 g-4">
                    @if (Model != null)
                    {
                        @foreach (var item in Model)
                        {
                            <a asp-controller="Categoria" asp-action="Produtos" asp-route-id="@item.Id"
                               class="d-flex p-2 text-decora">
                                <div class="card" style="width: 80%; text-align: center">
                                    <div class="card-body">
                                        <h2 class="card-title">@item.NomeCategoria</h2>
                                        <h5 class="card-title">@item.DescricaoCategoria</h5>
                                    </div>
                                </div>
                            </a>
                        }
                    }
                </div>
            </div>
        </div>
    </section>
</main>
